{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/assistant.ts": { "maxDuration": 60, "includeFiles": "public/za-geography.json" },
    "api/ai/*.ts": { "maxDuration": 60, "includeFiles": "public/za-geography.json" }
  },
  "rewrites": [{ "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }]
}
